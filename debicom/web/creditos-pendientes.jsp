<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@page import="Modelo.dto.CreditosPendientesDTO"%><%@page import="Modelo.dto.CreditoPendienteDTO"%>
<%if(session.getAttribute("idUsuario")==null){response.sendRedirect(request.getContextPath()+"/index.jsp");return;} CreditosPendientesDTO d=(CreditosPendientesDTO)request.getAttribute("creditosPendientes"); String ok=(String)request.getAttribute("ok"); String error=(String)request.getAttribute("error");%>
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Créditos pendientes | DebiCom</title><link rel="stylesheet" href="<%=request.getContextPath()%>/vista/CSS/styles.css"></head><body class="app-body"><div class="app-shell"><%@include file="WEB-INF/jspf/sidebar.jspf" %><main class="app-main"><section class="page-content"><div class="page-heading"><div><h1>Créditos pendientes</h1><p>Créditos aprobados con saldo pendiente. Abre un crédito para registrar su pago.</p></div><a class="button primary" href="<%=request.getContextPath()%>/vendedor/creditos/otorgar">Otorgar crédito</a></div>
<%if("pago".equals(ok)){%><article class="card" style="margin-bottom:16px;border-left:4px solid #2ecc71;"><strong>El pago presencial fue registrado correctamente.</strong></article><%}%><%if(error!=null&&!error.isBlank()){%><article class="card" style="margin-bottom:16px;border-left:4px solid #e74c3c;"><strong>Error:</strong> <%=error%></article><%}%>
<div class="metric-row"><article class="metric warning"><span class="label">Créditos activos</span><strong><%=d==null?0:d.getCreditosActivos()%></strong></article><article class="metric"><span class="label">Dinero por cobrar</span><strong>$<%=d==null?"0.00":d.getDineroTotalPorCobrar()%></strong></article><article class="metric"><span class="label">Clientes con deuda</span><strong><%=d==null?0:d.getClientesConDeuda()%></strong></article></div>
<article class="card"><div class="table-wrap"><table><thead><tr><th>Crédito</th><th>Cliente</th><th>Tienda</th><th>Monto</th><th>Saldo</th><th>Vencimiento</th><th>Mora</th><th>Acción</th></tr></thead><tbody><%if(d==null||d.getCreditos()==null||d.getCreditos().isEmpty()){%><tr><td colspan="8">No hay créditos pendientes.</td></tr><%}else for(CreditoPendienteDTO c:d.getCreditos()){%><tr><td>#<%=c.getIdSolicitud()%></td><td><%=c.getCliente()%></td><td><%=c.getTienda()%></td><td>$<%=c.getMontoOriginal()%></td><td><b>$<%=c.getSaldoPendiente()%></b></td><td><%=c.getFechaVencimiento()%></td><td><%=c.getDiasMora()%> días</td><td><a class="button primary tiny" href="<%=request.getContextPath()%>/vendedor/creditos/detalle?id=<%=c.getIdSolicitud()%>">Ver crédito y pagar</a></td></tr><%}%></tbody></table></div></article>
</section></main></div></body></html>
