<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@page import="Modelo.dto.SolicitudCreditoDTO"%><%@page import="Modelo.dto.DetalleCreditoDTO"%><%@page import="java.util.List"%><%@page import="Modelo.dto.ProductoDTO"%>
<%if(session.getAttribute("idUsuario")==null){response.sendRedirect(request.getContextPath()+"/index.jsp");return;} List<SolicitudCreditoDTO> solicitudes=(List<SolicitudCreditoDTO>)request.getAttribute("solicitudes"); DetalleCreditoDTO detalle=(DetalleCreditoDTO)request.getAttribute("detalleCredito");%>
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Estado del crédito | DebiCom</title><link rel="stylesheet" href="<%=request.getContextPath()%>/vista/CSS/styles.css"></head><body class="app-body"><div class="app-shell"><%@include file="WEB-INF/jspf/sidebar.jspf" %><main class="app-main"><section class="page-content"><div class="page-heading"><div><h1><%=detalle!=null?"Detalle de crédito":"Estado de mis créditos"%></h1><p><%=detalle!=null?"Detalle de la solicitud seleccionada.":"Consulta el estado de tus solicitudes."%></p></div></div>
<%if(detalle!=null){SolicitudCreditoDTO s=detalle.getSolicitud();%><article class="card"><div class="metric-row"><article class="metric"><span class="label">Crédito</span><strong>#<%=s.getIdSolicitud()%></strong></article><article class="metric"><span class="label">Cliente</span><strong><%=s.getCliente()%></strong></article><article class="metric"><span class="label">Tienda</span><strong><%=s.getTienda()%></strong></article><article class="metric"><span class="label">Estado</span><strong><%=s.getEstado()%></strong></article></div><p><b>Monto:</b> $<%=s.getMontoTotal()%> · <b>Saldo:</b> $<%=s.getSaldoPendiente()%> · <b>Vencimiento:</b> <%=s.getFechaVencimiento()%></p><p><b>Observaciones:</b> <%=s.getObservaciones()==null?"":s.getObservaciones()%></p></article><article class="card"><h2>Productos incluidos</h2><div class="table-wrap"><table><thead><tr><th>Producto</th><th>Stock actual</th><th>Precio</th><th>Estado</th></tr></thead><tbody><%detalle.getProductos(); for(ProductoDTO p:detalle.getProductos()){%><tr><td><%=p.getNombre()%></td><td><%=p.getStock()%></td><td>$<%=p.getPrecioUnitario()%></td><td><%=p.getEstado()%></td></tr><%}%></tbody></table></div></article><%}else{%><article class="card"><div class="table-wrap"><table><thead><tr><th>Crédito</th><th>Tienda</th><th>Monto</th><th>Saldo</th><th>Solicitud</th><th>Vencimiento</th><th>Estado</th></tr></thead><tbody><%if(solicitudes==null||solicitudes.isEmpty()){%><tr><td colspan="7">No hay solicitudes registradas.</td></tr><%}else for(SolicitudCreditoDTO s:solicitudes){%><tr><td>#<%=s.getIdSolicitud()%></td><td><%=s.getTienda()%></td><td>$<%=s.getMontoTotal()%></td><td>$<%=s.getSaldoPendiente()%></td><td><%=s.getFechaSolicitud()%></td><td><%=s.getFechaVencimiento()%></td><td><%=s.getEstado()%></td></tr><%}%></tbody></table></div></article><%}%>
</section></main></div></body></html>
