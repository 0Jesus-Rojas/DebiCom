<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@page import="Modelo.dto.CreditosPendientesDTO"%><%@page import="Modelo.dto.CreditoPendienteDTO"%><%@page import="java.util.*"%>
<%if(session.getAttribute("idUsuario")==null){response.sendRedirect(request.getContextPath()+"/index.jsp");return;} CreditosPendientesDTO d=(CreditosPendientesDTO)request.getAttribute("creditosPendientes"); String ok=(String)request.getAttribute("ok"); String error=(String)request.getAttribute("error");%>
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Créditos pendientes | DebiCom</title><link rel="stylesheet" href="<%=request.getContextPath()%>/vista/CSS/styles.css"></head><body class="app-body"><div class="app-shell"><%@include file="WEB-INF/jspf/sidebar.jspf" %><main class="app-main"><section class="page-content"><div class="page-heading"><div><h1>Créditos pendientes</h1><p>Créditos aprobados con saldo pendiente.</p></div></div>
<div class="metric-row"><article class="metric warning"><span class="label">Créditos activos</span><strong><%=d==null?0:d.getCreditosActivos()%></strong></article><article class="metric"><span class="label">Dinero por cobrar</span><strong>$<%=d==null?"0.00":d.getDineroTotalPorCobrar()%></strong></article><article class="metric"><span class="label">Clientes con deuda</span><strong><%=d==null?0:d.getClientesConDeuda()%></strong></article></div>
<% if ("pago".equals(ok)) { %><article class="card" style="margin-bottom:16px;border-left:4px solid #2ecc71;"><strong>El pago presencial fue registrado correctamente.</strong></article><% } %>
<% if (error != null && !error.isBlank()) { %><article class="card" style="margin-bottom:16px;border-left:4px solid #e74c3c;"><strong>Error:</strong> <%=error%></article><% } %>
<article class="card" style="margin-bottom:16px;"><h2>Registrar pago presencial</h2><p>Registra un abono recibido en efectivo por un comprador.</p><form class="dark-grid" method="post" action="<%=request.getContextPath()%>/vendedor/pagos/registrar"><label>ID del comprador<input type="number" name="idCliente" min="1" required placeholder="Ej. 5"></label><label>Monto pagado<input type="number" name="monto" min="0.01" step="0.01" required placeholder="0.00"></label><div class="form-actions"><button class="button primary" type="submit">Registrar pago</button></div></form></article>
<article class="card"><div class="table-wrap"><table><thead><tr><th>Crédito</th><th>Cliente</th><th>Tienda</th><th>Monto</th><th>Saldo</th><th>Vencimiento</th><th>Mora</th><th>Acción</th></tr></thead><tbody><%if(d!=null)for(CreditoPendienteDTO c:d.getCreditos()){%><tr><td>#<%=c.getIdSolicitud()%></td><td><%=c.getCliente()%></td><td><%=c.getTienda()%></td><td>$<%=c.getMontoOriginal()%></td><td>$<%=c.getSaldoPendiente()%></td><td><%=c.getFechaVencimiento()%></td><td><%=c.getDiasMora()%> días</td><td><a class="button secondary tiny" href="<%=request.getContextPath()%>/vendedor/creditos/detalle?id=<%=c.getIdSolicitud()%>">Detalles</a></td></tr><%}%></tbody></table></div></article>
</section></main></div></body></html>
