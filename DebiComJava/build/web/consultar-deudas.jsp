<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><%@page import="Modelo.dto.DeudaPendienteDTO"%><%@page import="java.util.List"%>
<%if(session.getAttribute("idUsuario")==null){response.sendRedirect(request.getContextPath()+"/index.jsp");return;} List<DeudaPendienteDTO> deudas=(List<DeudaPendienteDTO>)request.getAttribute("deudas");%>
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Deudas pendientes | DebiCom</title><link rel="stylesheet" href="<%=request.getContextPath()%>/vista/CSS/styles.css"></head><body class="app-body"><div class="app-shell"><%@include file="WEB-INF/jspf/sidebar.jspf" %><main class="app-main"><section class="page-content"><div class="page-heading"><div><h1>Deudas pendientes</h1><p>Consulta a quién debes, cuánto y la fecha de vencimiento.</p></div></div><div class="metric-row"><article class="metric"><span class="label">Deuda total</span><strong>$<%=request.getAttribute("deudaTotal")==null?"0.00":request.getAttribute("deudaTotal")%></strong></article><article class="metric success"><span class="label">Al día</span><strong><%=request.getAttribute("pagosAlDia")==null?0:request.getAttribute("pagosAlDia")%></strong></article><article class="metric danger"><span class="label">Vencidas</span><strong><%=request.getAttribute("pagosVencidos")==null?0:request.getAttribute("pagosVencidos")%></strong></article></div><article class="card"><div class="table-wrap"><table><thead><tr><th>Crédito</th><th>Tienda</th><th>Monto original</th><th>Saldo</th><th>Fecha de vencimiento</th><th>Estado</th></tr></thead><tbody><%if(deudas==null||deudas.isEmpty()){%><tr><td colspan="6">No tienes deudas pendientes.</td></tr><%}else for(DeudaPendienteDTO d:deudas){%><tr><td>#<%=d.getIdSolicitud()%></td><td><%=d.getTienda()%></td><td>$<%=d.getMontoOriginal()%></td><td>$<%=d.getSaldoPendiente()%></td><td><%=d.getFechaVencimiento()%></td><td><%=d.getEstado()%></td></tr><%}%></tbody></table></div></article></section></main></div></body></html>
